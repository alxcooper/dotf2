  export LIBRARY_PATH="${LIBRARY_PATH:+$LIBRARY_PATH:}/usr/local/lib:/opt/homebrew/lib"
  export CPATH="${CPATH:+$CPATH:}/usr/local/include:/opt/homebrew/include"
