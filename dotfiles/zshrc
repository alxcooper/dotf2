# Startup profiling. Run with ZSHRC_PROFILE=1 to print load time.
zmodload zsh/datetime 2>/dev/null
_zsh_start_time=${EPOCHREALTIME:-}

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# Useful functions
#
is_mac()  { [[ $OSTYPE == darwin*  ]]; }
is_linux(){ [[ $OSTYPE == linux*   ]]; }
is_wsl()  { [[ -n ${WSL_DISTRO_NAME:-} || "$(uname -r 2>/dev/null)" == *microsoft* ]]; }

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# Common environment configuration
#
typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "./bin"
  "./node_modules/.bin"
  $path
)

export ANSIBLE_NOCOWS=1
export HOMEBREW_NO_AUTO_UPDATE=true
export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8

if is_mac; then
  export CLICOLOR=1
  # If you'd like to mimic the colors of a typical Linux terminal
  # https://www.cyberciti.biz/faq/apple-mac-osx-terminal-color-ls-output-option/
  export LSCOLORS=exgxBxDxcxEgEdxbxgxcxd
fi

# Fix tmuxinator/tmuxp window titles.
export DISABLE_AUTO_TITLE='true'

if (( ${+commands[nvim]} )); then
  alias vim='nvim'
  export EDITOR='nvim'
elif (( ${+commands[vimx]} )); then
  # Use vimx if exists because it often has clipboard support.
  alias vim='vimx'
  export EDITOR='vimx'
else
  export EDITOR='vim'
fi
export VISUAL="$EDITOR"

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# History
#
HISTFILE="${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
ZSH_HISTORY_MAX_ENTRY_LENGTH="${ZSH_HISTORY_MAX_ENTRY_LENGTH:-1000}"
setopt EXTENDED_HISTORY          # Save timestamp
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY        # Add commands immediately
setopt SHARE_HISTORY             # Share history between sessions
setopt HIST_FCNTL_LOCK
setopt HIST_EXPIRE_DUPS_FIRST    # Remove duplicates first
setopt HIST_IGNORE_DUPS          # Don't record duplicate in a row
setopt HIST_FIND_NO_DUPS         # Don't show duplicates in search
setopt HIST_SAVE_NO_DUPS         # Don't write duplicates to history file
setopt HIST_REDUCE_BLANKS        # Remove extra blanks
setopt HIST_IGNORE_SPACE         # Manual control with leading space

zshaddhistory() {
  local line="${1%$'\n'}"
  local max_length="${ZSH_HISTORY_MAX_ENTRY_LENGTH:-1000}"

  # Keep pasted blobs and generated snippets out of history/fzf/autosuggestions.
  [[ $line == *$'\n'* ]] && return 1
  [[ $line == *$' \\'* ]] && return 1
  (( ${#line} > max_length )) && return 1

  return 0
}

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# CLI tool defaults
#
if (( ${+commands[eza]} )) && [[ -z ${EZA_COLORS:-} ]]; then
  _eza_colors=(
    reset
    di=34 ln=36 or=31 ex=32
    ur=0 uw=0 ux=0 ue=0
    gr=0 gw=0 gx=0
    tr=0 tw=0 tx=0
    su=31 sf=31 xa='2;90'
    sn=0 sb=0
    uu=0 un=0 uR=31
    gu=0 gR=31 gn=0
    da=0 hd='4;37'
    ga=32 gm=33 gd=31 gv=35 gt=33 gi='2;90' gc=31
    xx='2;90'
    bu=33 sc=0 cr=31 do=0 co=35 tm='2;90'
  )
  export EZA_COLORS="${(j.:.)_eza_colors}"
  unset _eza_colors
fi

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# Aliases
#
alias hrl='fc -RI' # history reload
alias tmux='tmux -2'
alias ta='tmux attach -t'
alias tnew='tmux new -s'
alias tls='tmux ls'
alias tkill='tmux kill-session -t'
alias gco='git checkout'
alias gb='git branch'
alias gba='git branch -a'
alias glp='git log --oneline --graph --decorate'
alias gl='git log'
alias gst='git status'
alias g='git status'
alias be='bundle exec'
alias bi='bundle install'
alias bu='bundle update'
alias bo='bundle open'
alias rs='bundle exec rails s'
alias rc='bundle exec rails c'
alias rdm='bundle exec rails db:migrate'
alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome'
alias lvim='NVIM_APPNAME=lvim nvim'

if (( ${+commands[eza]} )); then
  alias l='eza --icons=never --group-directories-first'
  alias ll='eza -la --icons=never --group-directories-first --no-user --time-style=long-iso'
  alias la='eza -la --icons=never --group-directories-first --time-style=long-iso'
  alias lg='eza -la --git --icons=never --group-directories-first --no-user --time-style=long-iso'
  alias lt='eza -a --tree --level=2 --icons=never --group-directories-first --ignore-glob ".git|node_modules|vendor/bundle|.DS_Store"'
  alias llt='eza -la --git --tree --level=2 --icons=never --group-directories-first --no-user --time-style=long-iso --ignore-glob ".git|node_modules|vendor/bundle|.DS_Store"'
else
  alias ll='ls -lah'
  alias la='ls -lah'
fi

if (( ${+commands[bat]} )); then
  alias b='bat'
  alias bp='bat --style=plain'
fi

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# Zinit and completion
#
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"
else
  print -u2 "zinit not found at $ZINIT_HOME; run: make install tags=zsh"
fi

if (( ${+functions[zinit]} )); then
  zinit light zsh-users/zsh-completions
fi

zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' rehash true
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes
zstyle ':completion:*' menu no
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*:descriptions' format '[%d]'
[[ -n ${LS_COLORS:-} ]] && zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

autoload -Uz compinit
_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$_zsh_cache_dir" ]] || mkdir -p "$_zsh_cache_dir"
_zcompdump="$_zsh_cache_dir/zcompdump-${ZSH_VERSION}"
_compinit_args=(-d "$_zcompdump")

if [[ -f "$_zcompdump" ]]; then
  zmodload zsh/stat 2>/dev/null
  typeset -A _zcompdump_stat
  if zstat -H _zcompdump_stat "$_zcompdump" 2>/dev/null &&
      (( EPOCHSECONDS - _zcompdump_stat[mtime] < 86400 )); then
    _compinit_args=(-C -d "$_zcompdump")
  fi
fi

compinit "${_compinit_args[@]}"
unset _zsh_cache_dir _zcompdump _compinit_args _zcompdump_stat

if (( ${+functions[zinit]} )); then
  zstyle ':fzf-tab:*' switch-group '<' '>'
  zinit light Aloxaf/fzf-tab

  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#595959"
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  zinit light zsh-users/zsh-autosuggestions
  bindkey '^j' autosuggest-accept
  bindkey '^f' autosuggest-accept
fi

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
# FZF integration
#
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git 2>/dev/null || rg --files'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git 2>/dev/null'

ff() {
  (( ${+commands[fzf]} )) || return 1

  local file
  file=$(fd --type f --hidden --follow --exclude .git 2>/dev/null |
    fzf \
      --color='preview-bg:#1f1f28,preview-fg:#dcd7ba,preview-border:#54546d' \
      --preview 'bat --style=numbers --color=always --line-range :200 {} 2>/dev/null || sed -n "1,200p" {}') || return

  ${EDITOR:-vim} "$file"
}

if (( ${+commands[fzf]} )) && [[ -o interactive && -t 0 && -t 1 ]]; then
  if is_mac; then
    _fzf_key_bindings=(
      /opt/homebrew/opt/fzf/shell/key-bindings.zsh
      /usr/local/opt/fzf/shell/key-bindings.zsh
    )
  else
    _fzf_key_bindings=(/usr/share/fzf/shell/key-bindings.zsh)
  fi

  for _fzf_key_bindings_file in $_fzf_key_bindings; do
    if [[ -r "$_fzf_key_bindings_file" ]]; then
      source "$_fzf_key_bindings_file"
      break
    fi
  done
  unset _fzf_key_bindings _fzf_key_bindings_file
fi

# = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
