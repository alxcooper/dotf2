if [[ ${ZSHRC_PROFILE:-0} == 1 && -n "$_zsh_start_time" && -n "${EPOCHREALTIME:-}" ]]; then
  printf 'zshrc loaded in %.0fms\n' $(( (EPOCHREALTIME - _zsh_start_time) * 1000 ))
fi
unset _zsh_start_time
